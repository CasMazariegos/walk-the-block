{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walk-the-block",
  // Same Cloudflare account as MERA. Not a secret; wrangler needs it so
  // `wrangler deploy` does not ask which account to use.
  "account_id": "601f243ce5ead517b6fdf706be768fa0",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
